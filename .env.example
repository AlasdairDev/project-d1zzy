MODE=development

# Database (`just init-env` rotates POSTGRES_PASSWORD and DATABASE_URL)
POSTGRES_USER=d1zzy
POSTGRES_PASSWORD=d1zzy
POSTGRES_DB=project_d1zzy_market
DATABASE_URL=postgresql+asyncpg://d1zzy:d1zzy@db:5432/project_d1zzy_market

# Redis
REDIS_URL=redis://redis:6379/0

# Security (`just init-env` fills SECRET_KEY, MARKET_KEY and SERVER_SIGNING_SEED)
SECRET_KEY=generate-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
CSRF_MAX_AGE_SECONDS=28800
RATE_LIMIT_PER_MINUTE=60
# 32 random bytes, base64. Encrypts listing/offer/rating blobs at rest. Rotating it makes
# existing data unreadable; back it up separately from the database.
MARKET_KEY=
# 32 random bytes, base64. Signs content submitted through the no-JS forms.
SERVER_SIGNING_SEED=
# Hide a listing automatically once this many different users have open reports on it.
AUTO_HIDE_REPORT_THRESHOLD=5

# PayMongo (Philippines: GCash, Maya, cards, bank transfer)
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...
PAYMONGO_WEBHOOK_SECRET=...

# Optional adapters, not used by the Philippines-only demo.
# Stripe (TEST MODE ONLY: sk_test_ keys; anything else disables card payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=php

# BTCPay Server (Lightning/on-chain). `just btcpay-up`, then create a store + API key in
# the BTCPay UI (http://localhost:23000) and paste them here.
BTCPAY_URL=http://btcpay:49392
BTCPAY_API_KEY=...
BTCPAY_STORE_ID=...
BTCPAY_WEBHOOK_SECRET=...

# Monero (optional, regtest via `just dev-crypto`; leave MONERO_RPC_URL empty to disable)
MONERO_RPC_URL=
# MONERO_RPC_URL=http://monero:18083/json_rpc
MONERO_RPC_USER=monero
MONERO_RPC_PASSWORD=monero
MONERO_NETWORK=testnet

# IPFS (Kubo, offline mode)
IPFS_API_URL=http://ipfs:5001/api/v0
IPFS_GATEWAY_URL=http://ipfs:8080/ipfs/

# Email (Mailpit in dev: http://localhost:8025)
EMAIL_FROM=noreply@d1zzy.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Tor
TOR_HOSTNAME_FILE=/run/tor-export/hostname

# ngrok (optional)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# App
PUBLIC_BASE_URL=http://localhost:8000
# Reporting channel for /.well-known/security.txt. Change this if you fork the project.
SECURITY_CONTACT=https://github.com/AlasdairDev/project-d1zzy/security/advisories/new
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
